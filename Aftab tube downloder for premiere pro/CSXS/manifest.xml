<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="6.0" ExtensionBundleId="com.aftab.tubedownloader" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Aftab Tube Downloder for Premiere Pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.aftab.tubedownloader.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Premiere Pro CC & CS6 (all versions up to CC 2026+) -->
            <Host Name="PPRO" Version="[6.0,99.9]" />
            <!-- After Effects CS6 through CC 2026+ -->
            <Host Name="AEFT" Version="[10.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="6.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.aftab.tubedownloader.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./host/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--enable-media-stream</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Aftab Tube Downloder</Menu>
                    <Geometry>
                        <Size>
                            <Width>980</Width>
                            <Height>640</Height>
                        </Size>
                        <MinSize>
                            <Width>680</Width>
                            <Height>480</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>2560</Width>
                            <Height>1600</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./assets/icon-normal.png</Icon>
                        <Icon Type="RollOver">./assets/icon-rollover.png</Icon>
                        <Icon Type="DarkNormal">./assets/icon-normal.png</Icon>
                        <Icon Type="DarkRollOver">./assets/icon-rollover.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
