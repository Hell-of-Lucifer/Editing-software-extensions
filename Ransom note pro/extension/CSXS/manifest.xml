<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.aftab.ransomnotepro" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Ransom Note Pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.aftab.ransomnotepro.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Adobe After Effects CS6 through CC 2026+ -->
            <Host Name="AEFT" Version="[10.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="7.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.aftab.ransomnotepro.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Ransom Note Pro</Menu>
                    <Geometry>
                        <Size>
                            <Width>1020</Width>
                            <Height>940</Height>
                        </Size>
                        <MinSize>
                            <Width>750</Width>
                            <Height>650</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>2560</Width>
                            <Height>1600</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./assets/presets/random_ransom.png</Icon>
                        <Icon Type="RollOver">./assets/presets/random_ransom.png</Icon>
                        <Icon Type="Disabled">./assets/presets/random_ransom.png</Icon>
                        <Icon Type="DarkNormal">./assets/presets/random_ransom.png</Icon>
                        <Icon Type="DarkRollOver">./assets/presets/random_ransom.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
